{
  "emmet.showExpandedAbbreviation": "never",

  // Tailwind CSS IntelliSense
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },

  // Oxfmt
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,

  // Oxlint
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "cSpell.words": [
    "heroui",
    "mwskwong",
    "oklch",
    "oxfmt",
    "oxlint",
    "tsgolint",
    "ultracite",
    "WCAG"
  ]
}
